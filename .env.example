# Optional grounded answer generation. Without this key, the project uses its local
# extractive answerer and remains completely offline after installation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Local development defaults
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only for newly added scans without reviewed sidecars; requires local Tesseract.
ENABLE_OCR=false
OCR_LANGUAGE=eng
